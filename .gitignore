node_modules/
dist/
tmp/

# Generated by `npm run build:fonts` from a licensed copy of Helvetica. The subset faces are the
# font, so they are rebuilt on each machine rather than committed. src/logo/fontMetrics.js is
# generated too but *is* committed: advance widths are what the layout engine needs to run, and
# they are not the typeface.
src/fonts/generated/
src/fonts.css

# Generated by `npm run build:capabilities` from the application's own constants, so it cannot
# drift from what it describes. Vite copies it to dist/capabilities.json.
public/capabilities.json

# Extracted from the Province's published PDF by `npm run extract:current-marks`. No longer
# committed: the app builds its lockups from the deduplicated alphabet and the mark, both of which
# are committed, so these 46 files are only an intermediate on the way to regenerating those. The
# PDF they come from is the real source and is in artwork/.
public/current-marks/

# Intermediates of `npm run build:current`: what the wording was read back as, and the fit
# measured from it. Both need the artwork and a licensed font to regenerate, and both only
# exist to produce the committed files above.
scripts/current-names.json
scripts/current-fit.json

# Generated by `npm run build:current-glyphs` from a licensed copy of Adobe Garamond Pro — the
# serif the B.C. Visual Identity Program specifies. These are the letters the Province's own marks
# do not happen to contain, and a full alphabet of outlines is the typeface however it is stored,
# so they are rebuilt per machine rather than committed. src/current/nameGlyphs.js (the letters
# that *are* in the published artwork) and src/current/nameMetrics.js (widths and kerning, not
# letterforms) are committed, so the app works without this.
src/current/generated/

# Python bytecode from the extraction scripts.
__pycache__/

# macOS folder metadata.
.DS_Store
