node_modules/
dist/
tmp/

# Generated by `npm run build:fonts` from a licensed copy of Helvetica. The subset faces are the
# font, so they are rebuilt on each machine rather than committed. src/logo/fontMetrics.js is
# generated too but *is* committed: advance widths are what the layout engine needs to run, and
# they are not the typeface.
src/fonts/generated/
src/fonts.css

# Generated by `npm run build:capabilities` from the application's own constants, so it cannot
# drift from what it describes. Vite copies it to dist/capabilities.json.
public/capabilities.json

# Extracted from the Province's published PDF by `npm run extract:current-marks`. No longer
# committed: the app builds its lockups from the deduplicated alphabet and the mark, both of which
# are committed, so these 46 files are only an intermediate on the way to regenerating those. The
# PDF they come from is the real source and is in artwork/.
public/current-marks/

# Regenerated byte for byte from the shared outlines in artwork/cleanbc/.
/public/identity-collected/cleanbc/base-wordmark-white.svg
/public/identity-collected/cleanbc/better-buildings-endorsed-black.svg
/public/identity-collected/cleanbc/better-buildings-endorsed-positive.svg
/public/identity-collected/cleanbc/better-buildings-endorsed-reverse.svg
/public/identity-collected/cleanbc/better-buildings-endorsed-white.svg
/public/identity-collected/cleanbc/better-buildings-wordmark-black.svg
/public/identity-collected/cleanbc/better-buildings-wordmark-positive.svg
/public/identity-collected/cleanbc/better-buildings-wordmark-reverse.svg
/public/identity-collected/cleanbc/better-buildings-wordmark-white.svg

# Intermediates of `npm run build:current`: what the wording was read back as, and the fit
# measured from it. Both need the artwork and a licensed font to regenerate, and both only
# exist to produce the committed files above.
scripts/current-names.json
scripts/current-fit.json

# Generated by `npm run build:current-glyphs` from a licensed copy of Adobe Garamond Pro — the
# serif the B.C. Visual Identity Program specifies. These are the letters the Province's own marks
# do not happen to contain, and a full alphabet of outlines is the typeface however it is stored,
# so they are rebuilt per machine rather than committed. src/current/nameGlyphs.js (the letters
# that *are* in the published artwork) and src/current/nameMetrics.js (widths and kerning, not
# letterforms) are committed, so the app works without this.
src/current/generated/

# PackCAD's viewer, built from vendor/packcad by `npm run build:packcad` (part of build:assets) for the
# Paper Models view. Vite copies it to dist/packcad/.
public/packcad/

# Python bytecode from the extraction scripts.
__pycache__/

# macOS folder metadata.
.DS_Store

# Temporary salary-only verification builds
.salary-preview-*/
dist-salaries/
public/.salaries-build-*/

# Derived from published salary rows and reviewed name links at build/preview time.
public/salaries/search/
public/salaries/.name-search-*/
# Packed from the two published salary indexes for the browser, likewise.
public/salaries/browse-index.json.gzip

# Standalone health-map review, without the licensed artwork-font build.
.health-map-preview-*/
dist-health-map/

# Standalone gallery review using the same source components.
.gallery-preview-*/
dist-gallery/

# Rasterized native SVG references used while rebuilding patch source crops.
.cache/patch-review-svg/

# Screenshots from npm run shots:salaries
.shots/

# Era brand folders and packs from npm run brandkit:build / brandkit:pack (see brandkit/README.md).
brandkit/out/

# Public Accounts PDFs fetched for research/finance (large; every URL is in the CSVs)
research/finance/public-accounts-23-1/cache/
# Summary Financial Statements PDFs for the Budget mode (extract_statement_of_operations.py --fetch)
research/finance/province-summary/cache/

# Downloaded source files for the finance research (transfers CSVs, CRF schedules, Supplement CSVs, statement text)
research/finance/cache/
