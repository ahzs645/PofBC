{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BC Atlas research event seeds",
  "type": "object",
  "required": [
    "metadata",
    "events"
  ],
  "properties": {
    "metadata": {
      "type": "object"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "subject_key",
          "event_type",
          "title",
          "date",
          "temporal_status",
          "evidence",
          "integration_status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^seed:"
          },
          "subject_key": {
            "type": "string"
          },
          "event_type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "object",
            "required": [
              "start",
              "end",
              "precision",
              "range_end_inclusive"
            ],
            "properties": {
              "start": {
                "type": "string",
                "pattern": "^\\d{4}(-\\d{2})?(-\\d{2})?$"
              },
              "end": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "precision": {
                "enum": [
                  "day",
                  "year",
                  "month",
                  "day_range",
                  "month_range",
                  "year_range"
                ]
              },
              "range_end_inclusive": {
                "type": "boolean"
              }
            }
          },
          "temporal_status": {
            "enum": [
              "source_reported_past",
              "scheduled",
              "planned"
            ]
          },
          "evidence": {
            "type": "object",
            "required": [
              "source_ids",
              "basis"
            ],
            "properties": {
              "source_ids": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^S\\d{2}$"
                }
              },
              "basis": {
                "type": "string"
              }
            }
          },
          "integration_status": {
            "const": "needs_local_id_mapping_and_review"
          }
        }
      }
    }
  }
}
