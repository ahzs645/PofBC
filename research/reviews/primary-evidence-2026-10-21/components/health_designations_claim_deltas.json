{
  "reviewed_at": "2026-10-21",
  "claims": [
    {
      "id": "HD001",
      "claim": "All 34 councils in the 1997 framework are recoverable from seven contemporary designation and continuation orders, adding sections 2–35 to Reg. 27/97: 30 continued councils and four newly designated combined councils.",
      "evidence_type": "reconstructed_from_original_instruments",
      "sources": [
        "HDS001",
        "HDS005",
        "HDS012",
        "HDS014",
        "HDS027",
        "HDS033",
        "HDS036"
      ],
      "change": "Replace 2000-only starts. Preserve earlier original designations where proved; a 1997 continuation is a different event."
    },
    {
      "id": "HD002",
      "claim": "OIC1298/1994 regulates composition and can name bodies before their separate designation. Northern Interior designation M357/1994 expressly takes effect 17 November 1994.",
      "sources": [
        "HDS078",
        "HDS058"
      ],
      "corrects_prior_claim": "HL20 existence-by 13 Oct 1994 inference",
      "change": "Correct prior HL20: record composition specified 13 October 1994 and statutory designation effective 17 November 1994 as different events."
    },
    {
      "id": "HD003",
      "claim": "M597/1995, made 6 December 1995, repeals 20 individual board regulations and designates a named 20-board set with geographic schedules.",
      "sources": [
        "HDS053"
      ],
      "change": "Add the 1995 consolidated designation event; preserve the earlier individual designation dates."
    },
    {
      "id": "HD004",
      "claim": "M366/1999 removes section 35 and the Nisga’a area from Reg. 27/97; Reg. 333/99 was deposited 18 October 1999. This explains 34 councils in 1997 versus 33 in the 2001 statutory list.",
      "sources": [
        "HDS080",
        "HDS079"
      ],
      "change": "Retain Nisga’a in the 1997 roster and record the 1999 designation removal. Do not infer that Nisga’a healthcare ended or merged into Northern."
    },
    {
      "id": "HD005",
      "claim": "M96/1997 has ambiguous handwriting in its date line. Sea to Sky M444/1994 has an appointment-form cover and designation annex, leaving the original effective day unconfirmed.",
      "sources": [
        "HDS027",
        "HDS030"
      ],
      "change": "Use March 1997 precision for M96 until corroborated. Use Reg. 481/94 and 1994 year precision for Sea to Sky’s original designation; do not invent an exact day."
    },
    {
      "id": "HD006",
      "claim": "M45/1999 (Reg. 31/99) repeals Reg. 521/95 and Reg. 228/94 effective 28 February 1999; deposit was 4 February 1999.",
      "sources": [
        "HDS079"
      ],
      "change": "Investigate the formal end of residual rural board designations separately from operational replacement in 1997. Do not give all 20 boards a common 1999 end without their intervening amendment history."
    },
