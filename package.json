{
  "name": "pofbc-logo",
  "private": true,
  "version": "0.1.0",
  "description": "Province of British Columbia logo generator \u2014 four lockups, colour variants, and SVG/PDF/PNG/WebP/JPEG export.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/logo/renderLogoSvg.js",
    "./fonts.css": "./src/fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "artwork"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "npm run build:assets --silent && vite",
    "build": "npm run build:assets --silent && vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\" \"scripts/**/*.test.mjs\"",
    "build:assets": "npm run vendor:build --silent && node scripts/build-mark.mjs && node scripts/build-fonts.mjs && node scripts/build-capabilities.mjs",
    "build:mark": "node scripts/build-mark.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "compare": "node scripts/compare-artwork.mjs",
    "deploy": "npm run build && npx gh-pages -d dist",
    "vendor:build": "node scripts/build-vendor-json-url.mjs",
    "prepare": "npm run vendor:build --silent",
    "build:capabilities": "node scripts/build-capabilities.mjs",
    "extract:current-marks": "python3 scripts/extract_current_marks.py"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "jspdf": "^3.0.1",
    "svg2pdf.js": "^2.5.0",
    "@firstform/json-url": "file:vendor/json-url",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "fontkit": "^2.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "subset-font": "^2.4.0",
    "vite": "^8.0.16"
  }
}
