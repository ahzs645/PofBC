{
  "name": "pofbc-logo",
  "private": true,
  "version": "0.1.0",
  "description": "Province of British Columbia logo generator \u2014 four lockups, colour variants, and SVG/PDF/PNG/WebP/JPEG export.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": "./src/index.js",
    "./core": "./src/logo/renderLogoSvg.js",
    "./fonts.css": "./src/fonts.css",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "scripts",
    "artwork"
  ],
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "npm run build:assets --silent && vite",
    "build": "npm run build:assets --silent && vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.js\" \"scripts/**/*.test.mjs\"",
    "build:assets": "npm run vendor:build --silent && node scripts/build-mark.mjs && node scripts/build-fonts.mjs && node scripts/build-current-extras.mjs && node scripts/build-capabilities.mjs",
    "build:mark": "node scripts/build-mark.mjs",
    "build:fonts": "node scripts/build-fonts.mjs",
    "compare": "node scripts/compare-artwork.mjs",
    "deploy": "npm run build && npx gh-pages -d dist",
    "vendor:build": "node scripts/build-vendor-json-url.mjs",
    "prepare": "npm run vendor:build --silent",
    "build:capabilities": "node scripts/build-capabilities.mjs",
    "extract:current-marks": "python3 scripts/extract_current_marks.py",
    "recover:current-names": "python3 scripts/recover_current_names.py",
    "verify:current-names": "node scripts/verify-current-names.mjs",
    "build:current-glyphs": "node scripts/build-current-glyphs.mjs",
    "lift:current-letters": "node scripts/lift-current-letters.mjs",
    "build:current-mark": "node scripts/build-current-mark.mjs",
    "build:current-catalogue": "node scripts/build-current-catalogue.mjs",
    "compare:current": "node scripts/compare-current-lockups.mjs",
    "build:current": "npm run extract:current-marks && npm run recover:current-names && npm run verify:current-names && npm run build:current-glyphs && npm run lift:current-letters && npm run build:current-mark && npm run build:current-catalogue && npm run compare:current",
    "build:current-extras": "node scripts/build-current-extras.mjs",
    "build:flag": "node scripts/build-flag.mjs",
    "build:one-offs": "node scripts/build-one-offs.mjs",
    "build:crown-marks": "node scripts/build-crown-marks.mjs",
    "build:collecting": "node scripts/build-collecting.mjs",
    "build:collected-marks": "node scripts/build-collected-marks.mjs",
    "build:salaries": "node scripts/build-salaries.mjs",
    "follow-up:municipal-salaries": "node scripts/build-municipal-follow-up.mjs",
    "review:sector-salaries": "python3 scripts/build-sector-salary-review.py --frozen",
    "review:municipal-wave": "python3 scripts/build-municipal-wave-review.py",
    "preview:salaries": "node scripts/preview-salaries.mjs",
    "check:salaries": "node scripts/check-salary-exports.mjs --write-inventory",
    "build:crest": "python3 scripts/build_crest.py",
    "build:ministry-history": "node scripts/build-ministry-history.mjs",
    "build:government-history": "node scripts/build-government-history.mjs",
    "build:health-map": "node scripts/build-health-map-catalogue.mjs",
    "build:government-events": "node scripts/build-government-events.mjs",
    "build:government-atlas": "node scripts/build-government-atlas.mjs",
    "build:research-brief": "node scripts/build-research-brief.mjs",
    "build:hydro-serif": "node scripts/build-hydro-serif.mjs",
    "extract:hydro-marks": "python3 scripts/extract_hydro_marks.py",
    "build:government-research": "node scripts/build-government-research.mjs",
    "build:government": "npm run build:government-history && npm run build:government-events && npm run build:government-atlas && npm run build:government-research && npm run build:research-brief && npm run build:research-queue",
    "check:government": "node scripts/check-government-drift.mjs",
    "build:research-queue": "node scripts/build-research-queue.mjs",
    "research:merge": "node scripts/merge-research.mjs",
    "audit:municipal-salaries": "node scripts/audit-municipal-salaries.mjs",
    "compare:municipal-periods": "node scripts/compare-municipal-periods.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@firstform/json-url": "file:vendor/json-url",
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/roboto-condensed": "^5.3.0",
    "@fontsource/roboto-slab": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.24",
    "@xmldom/xmldom": "^0.9.12",
    "bwip-js": "^4.11.4",
    "d3-geo": "3.1.1",
    "docx": "^9.12.0",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "jspdf": "^3.0.4",
    "motion": "^13.5.1",
    "mp4-muxer": "^5.2.2",
    "opentype.js": "^2.0.0",
    "pptxgenjs": "^4.0.1",
    "svg2pdf.js": "^2.9.0",
    "webm-muxer": "^5.1.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.2",
    "fontkit": "^2.0.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "subset-font": "^2.4.0",
    "vite": "^8.0.16"
  }
}
