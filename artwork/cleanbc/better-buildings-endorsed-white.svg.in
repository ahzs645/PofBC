<?xml version="1.0" encoding="UTF-8"?>
<svg id="Layer_1" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{width}} {{height}}">
  <defs>
    <style>
      .cls-1, .cls-2 {
        fill: {{white}};
      }

      .cls-2 {
        fill-rule: evenodd;
      }

      .cls-3 {
        fill: none;
      }
    </style>
  </defs>
  <g>
    <path class="cls-1" d="{{capital-b}}"/>
    <path class="cls-1" d="{{lowercase-e}}"/>
    <path class="cls-1" d="{{lowercase-l}}"/>
    <path class="cls-1" d="{{lowercase-a}}"/>
    <path class="cls-1" d="{{capital-c}}"/>
    <path class="cls-1" d="{{right-leaf}}"/>
    <path class="cls-1" d="{{left-leaf}}"/>
    <path class="cls-1" d="{{lowercase-n}}"/>
    <path class="cls-1" d="{{lowercase-c}}"/>
  </g>
  <rect class="cls-1" {{divider}}/>
  <rect class="cls-3" width="{{width}}" height="{{height}}"/>
  <g>
    <path class="cls-1" d="{{better-B}}"/>
    <path class="cls-1" d="{{better-E-1}}"/>
    <path class="cls-1" d="{{better-T-1}}"/>
    <path class="cls-1" d="{{better-T-2}}"/>
    <path class="cls-1" d="{{better-E-2}}"/>
    <path class="cls-1" d="{{better-R}}"/>
    <path class="cls-1" d="{{buildings-B}}"/>
    <path class="cls-1" d="{{buildings-U}}"/>
    <path class="cls-1" d="{{buildings-I-1}}"/>
    <path class="cls-1" d="{{buildings-L}}"/>
    <path class="cls-1" d="{{buildings-D}}"/>
    <path class="cls-1" d="{{buildings-I-2}}"/>
    <path class="cls-1" d="{{buildings-N}}"/>
    <path class="cls-1" d="{{buildings-G}}"/>
    <path class="cls-1" d="{{buildings-S}}"/>
  </g>
  <g>
    <path class="cls-2" d="{{white-mountains-sun}}"/>
    <path class="cls-1" d="{{white-symbol-background}}"/>
  </g>
{{archivalSpacer}}
  <g id="British_Columbia" data-name="British Columbia">
    <path id="A" class="cls-1" d="{{province-A}}"/>
    <path id="I" class="cls-1" d="{{province-I-1}}"/>
    <path id="B" class="cls-1" d="{{province-B-1}}"/>
    <path id="M" class="cls-1" d="{{province-M}}"/>
    <path id="U" class="cls-1" d="{{province-U}}"/>
    <path id="L" class="cls-1" d="{{province-L}}"/>
    <path id="O" class="cls-1" d="{{province-O}}"/>
    <path id="C" class="cls-1" d="{{province-C}}"/>
    <path id="H" class="cls-1" d="{{province-H-white}}"/>
    <path id="S" class="cls-1" d="{{province-S}}"/>
    <path id="I-2" data-name="I" class="cls-1" d="{{province-I-2}}"/>
    <path id="T" class="cls-1" d="{{province-T}}"/>
    <path id="I-3" data-name="I" class="cls-1" d="{{province-I-3}}"/>
    <path id="R" class="cls-1" d="{{province-R}}"/>
    <path id="B-2" data-name="B" class="cls-1" d="{{province-B-2}}"/>
  </g>
</svg>
