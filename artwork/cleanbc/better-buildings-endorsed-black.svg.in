<?xml version="1.0" encoding="UTF-8"?>
<svg id="Layer_1" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{width}} {{height}}">
  <defs>
    <style>
      .cls-1 {
        fill: {{white}};
      }

      .cls-2 {
        fill: none;
      }

      .cls-3 {
        fill: {{black}};
      }
    </style>
  </defs>
  <g>
    <g>
      <path class="cls-3" d="{{capital-b}}"/>
      <path class="cls-3" d="{{lowercase-e}}"/>
      <path class="cls-3" d="{{lowercase-l}}"/>
      <path class="cls-3" d="{{lowercase-a}}"/>
      <path class="cls-3" d="{{capital-c}}"/>
      <path class="cls-3" d="{{right-leaf}}"/>
      <path class="cls-3" d="{{left-leaf}}"/>
      <path class="cls-3" d="{{lowercase-n}}"/>
      <path class="cls-3" d="{{lowercase-c}}"/>
    </g>
    <g>
      <g id="British_Columbia" data-name="British Columbia">
        <path id="A" class="cls-3" d="{{province-A}}"/>
        <path id="I" class="cls-3" d="{{province-I-1}}"/>
        <path id="B" class="cls-3" d="{{province-B-1}}"/>
        <path id="M" class="cls-3" d="{{province-M}}"/>
        <path id="U" class="cls-3" d="{{province-U}}"/>
        <path id="L" class="cls-3" d="{{province-L}}"/>
        <path id="O" class="cls-3" d="{{province-O}}"/>
        <path id="C" class="cls-3" d="{{province-C}}"/>
        <path id="H" class="cls-3" d="{{province-H}}"/>
        <path id="S" class="cls-3" d="{{province-S}}"/>
        <path id="I-2" data-name="I" class="cls-3" d="{{province-I-2}}"/>
        <path id="T" class="cls-3" d="{{province-T}}"/>
        <path id="I-3" data-name="I" class="cls-3" d="{{province-I-3}}"/>
        <path id="R" class="cls-3" d="{{province-R}}"/>
        <path id="B-2" data-name="B" class="cls-3" d="{{province-B-2}}"/>
      </g>
      <path id="White_Symbol_Bkgd" data-name="White Symbol Bkgd" class="cls-1" d="{{symbol-background}}"/>
      <g id="Gold_Sunrays" data-name="Gold Sunrays">
        <polygon class="cls-3" points="{{sunrayPointList}}"/>
        <path class="cls-3" d="{{sunrays}}"/>
      </g>
      <path id="Blue_Mountains_Water" data-name="Blue Mountains Water" class="cls-3" d="{{mountains-water}}"/>
    </g>
    <rect class="cls-3" {{divider}}/>
  </g>
  <rect class="cls-2" width="{{width}}" height="{{height}}"/>
  <g>
    <path class="cls-3" d="{{better-B}}"/>
    <path class="cls-3" d="{{better-E-1}}"/>
    <path class="cls-3" d="{{better-T-1}}"/>
    <path class="cls-3" d="{{better-T-2}}"/>
    <path class="cls-3" d="{{better-E-2}}"/>
    <path class="cls-3" d="{{better-R}}"/>
    <path class="cls-3" d="{{buildings-B}}"/>
    <path class="cls-3" d="{{buildings-U}}"/>
    <path class="cls-3" d="{{buildings-I-1}}"/>
    <path class="cls-3" d="{{buildings-L}}"/>
    <path class="cls-3" d="{{buildings-D}}"/>
    <path class="cls-3" d="{{buildings-I-2}}"/>
    <path class="cls-3" d="{{buildings-N}}"/>
    <path class="cls-3" d="{{buildings-G}}"/>
    <path class="cls-3" d="{{buildings-S}}"/>
  </g>
</svg>
