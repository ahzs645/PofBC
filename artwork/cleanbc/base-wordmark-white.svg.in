<?xml version="1.0" encoding="UTF-8"?>
<svg id="Layer_1" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{width}} {{height}}">
  <defs>
    <style>
      .cls-1 {
        fill: {{white}};
      }

      .cls-2 {
        fill: none;
      }
    </style>
  </defs>
  <g>
    <path class="cls-1" d="{{capital-b}}"/>
    <path class="cls-1" d="{{lowercase-e}}"/>
    <path class="cls-1" d="{{lowercase-l}}"/>
    <path class="cls-1" d="{{lowercase-a}}"/>
    <path class="cls-1" d="{{capital-c}}"/>
    <path class="cls-1" d="{{right-leaf}}"/>
    <path class="cls-1" d="{{left-leaf}}"/>
    <path class="cls-1" d="{{lowercase-n}}"/>
    <path class="cls-1" d="{{lowercase-c}}"/>
  </g>
  <rect class="cls-2" width="{{width}}" height="{{height}}"/>
</svg>
