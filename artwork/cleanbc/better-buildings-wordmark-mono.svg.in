<?xml version="1.0" encoding="UTF-8"?>
<svg id="Layer_1" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {{width}} {{height}}">
  <defs>
    <style>
      .cls-1 {
        fill: {{firstFill}};
      }

      .cls-2 {
        fill: {{secondFill}};
      }
    </style>
  </defs>
  <g>
    <g>
      <path class="cls-{{inkClass}}" d="{{capital-b}}"/>
      <path class="cls-{{inkClass}}" d="{{lowercase-e}}"/>
      <path class="cls-{{inkClass}}" d="{{lowercase-l}}"/>
      <path class="cls-{{inkClass}}" d="{{lowercase-a}}"/>
      <path class="cls-{{inkClass}}" d="{{capital-c}}"/>
      <path class="cls-{{inkClass}}" d="{{right-leaf}}"/>
      <path class="cls-{{inkClass}}" d="{{left-leaf}}"/>
      <path class="cls-{{inkClass}}" d="{{lowercase-n}}"/>
      <path class="cls-{{inkClass}}" d="{{lowercase-c}}"/>
    </g>
    <g>
      <path class="cls-{{inkClass}}" d="{{better-B}}"/>
      <path class="cls-{{inkClass}}" d="{{better-E-1}}"/>
      <path class="cls-{{inkClass}}" d="{{better-T-1}}"/>
      <path class="cls-{{inkClass}}" d="{{better-T-2}}"/>
      <path class="cls-{{inkClass}}" d="{{better-E-2}}"/>
      <path class="cls-{{inkClass}}" d="{{better-R}}"/>
      <path class="cls-{{inkClass}}" d="{{buildings-B}}"/>
      <path class="cls-{{inkClass}}" d="{{buildings-U}}"/>
      <path class="cls-{{inkClass}}" d="{{buildings-I-1}}"/>
      <path class="cls-{{inkClass}}" d="{{buildings-L}}"/>
      <path class="cls-{{inkClass}}" d="{{buildings-D}}"/>
      <path class="cls-{{inkClass}}" d="{{buildings-I-2}}"/>
      <path class="cls-{{inkClass}}" d="{{buildings-N}}"/>
      <path class="cls-{{inkClass}}" d="{{buildings-G}}"/>
      <path class="cls-{{inkClass}}" d="{{buildings-S}}"/>
    </g>
  </g>
  <rect class="cls-{{canvasClass}}" width="{{width}}" height="{{height}}"/>
</svg>
